@startuml draft-Domain
!include ../../_Style.puml

skinparam classAttributeIconSize 0

class Клиент {
    + id : UUID
    + имя : String
    + телефон : String
    + рейтинг : Float
}

class Отзыв {
    + id : UUID
    + оценка : Int
    + комментарий : String
    + дата : DateTime
}

class Водитель {
    + id : UUID
    + имя : String
    + авто : String
    + рейтинг : Float
    + статус : Enum
}

class Тариф {
    + id : UUID
    + название : String
    + базовая_цена : Decimal
    + коэффициент : Float
}

class Поездка {
    + id : UUID
    + адрес_откуда : String
    + адрес_куда : String
    + цена : Decimal
    + статус : Enum
    + время_создания : DateTime
}

' --- Связи для формирования правильной иерархии (сверху вниз) ---

' Клиент -> Отзыв (вниз)
Клиент "1" -down- "0..*" Отзыв : оставляет >

' Клиент -> Поездка (длинная ветка слева вниз)
Клиент "1" -down- "0..*" Поездка : создает >

' Отзыв <- Водитель (Отзыв выше Водителя)
Отзыв "0..*" -down- "1" Водитель : оценивает >

' Водитель -> Поездка (вниз)
Водитель "1" -down- "0..*" Поездка : выполняет >

' Тариф -> Поездка (вниз, но располагаем Тариф справа)
Тариф "1" -down- "0..*" Поездка : применяется >

' Невидимая связь, чтобы поставить Тариф на один уровень с Водителем (справа)
Водитель -right[hidden]- Тариф

@enduml