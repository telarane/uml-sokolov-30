@startuml object-flow.puml
!include ../../_Style.puml
title Процесс оформления заказа: поток объектов

skinparam defaultFontSize 11

start
:Клиент указывает адреса;
:Заказ [ЧЕРНОВИК]/
:Система проверяет данные и рассчитывает стоимость;
:Заказ [СОЗДАН]/
:Клиент подтверждает заказ;
:Заказ [ПОДБОР_ВОДИТЕЛЯ]/

if (Водитель найден?) then (нет)
    :Заказ [ОТМЕНЁН]/
    stop
else (да)
    :Водитель принимает заказ;
endif

:Заказ [ВОДИТЕЛЬ_НАЗНАЧЕН]/
:Водитель подаёт машину;
:Заказ [В_ПУТИ]/

if (Поездка завершена?) then (нет)
    :Заказ [ОТМЕНЁН]/
    stop
else (да)
    :Клиент оплачивает поездку;
endif

:Заказ [ЗАВЕРШЁН]/
stop
@enduml