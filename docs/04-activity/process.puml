@startuml process.puml
!include ../../_Style.puml
title Процесс «Заказ поездки в такси»

' Уменьшаем шрифт и отступы только для этой диаграммы
skinparam activity {
    FontSize 11
    ArrowThickness 1
}
skinparam defaultFontSize 11

|Клиент|
start
:Указать адреса;

|Система|
:Рассчитать маршрут\nи стоимость;
:Показать стоимость;

|Клиент|
if (Цена устраивает?) then (нет)
    :Отменить заказ;
    |Система|
    :Завершить;
    stop
else (да)
    :Подтвердить;
endif

|Система|
:Проверить статус\nклиента;
if (Заблокирован?) then (да)
    :Показать ошибку;
    stop
else (нет)
    :Начать поиск;
endif

fork
    :Найти водителя\n(радиус 5 км);
fork again
    :Резерв средств\n(платежный шлюз);
fork again
    :Сформировать чек;
end fork

:Отправить предложение;

|Водитель|
:Получить предложение;
if (Принять?) then (да)
    :Подтвердить;
else (нет)
    :Отклонить;
    |Система|
    :Блокировка\nводителя на 5 мин;
    stop
endif

|Система|
:Уведомить клиента;

|Клиент|
:Ожидать машину;

|Водитель|
:Начать поездку;

|Система|
:Списать средства;

|Клиент|
:Завершить поездку;

|Система|
:Зафиксировать\nзавершение;
stop
@enduml