@startuml
!include ../../_Style.puml
title Жизненный цикл «Заказ»

hide empty description

' 1. Объявление состояний
state Черновик
state Размещён
state Оплачен {
    state Комплектуется
    state Упакован
    [*] --> Комплектуется
    Комплектуется --> Упакован : всёСобрано
    Упакован --> [*]
}
state В_ПУТИ
state Доставлен
state Отменён

' 6. Действие при входе (entry)
Черновик : entry / создатьНомер()

' Начальное состояние
[*] --> Черновик

' 5. Сторожевые условия в квадратных скобках
Черновик --> Размещён : подтвердить()\n[корзина не пуста]
Черновик --> Черновик : подтвердить()\n[корзина пуста] / показатьОшибку()

' 4. Переход по времени (after)
Размещён --> Оплачен : оплатаПолучена
Размещён --> Отменён : after(24 ч) / вернутьРезерв()

' Основной поток
Оплачен --> В_ПУТИ : передатьВДоставку()
В_ПУТИ --> Доставлен : курьерОтметил

' 7. Переход «назад» (возврат в предыдущее состояние)
В_ПУТИ --> Отменён : отказПолучателя / вернутьДеньги()
Оплачен --> Отменён : отменить()

' 2. Минимум два конечных псевдосостояния
Доставлен --> [*]
Отменён --> [*]

@enduml